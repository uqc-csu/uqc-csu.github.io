---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Research from '../components/modules/Research.astro';
import { researchAreas, pageContent } from '../lib/content';
---

<BaseLayout title={pageContent.research.title}>
  <section class="page-intro"><SectionIntro {...pageContent.research} /></section>
  <section class="page-content"><div class="page-shell reading-width"><Research items={researchAreas} /></div></section>
</BaseLayout>
