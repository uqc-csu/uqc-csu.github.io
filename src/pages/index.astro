---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleSection from '../components/ModuleSection.astro';
import Hero from '../components/modules/Hero.astro';
import Research from '../components/modules/Research.astro';
import People from '../components/modules/People.astro';
import PublicationArchive from '../components/modules/PublicationArchive.astro';
import News from '../components/modules/News.astro';
import Contact from '../components/modules/Contact.astro';
import { site, sectionContent, researchAreas, people, publications, newsItems, contact } from '../lib/content';
---

<BaseLayout title="Home">
  <Hero content={site} affiliation={contact} topics={researchAreas} />
  <ModuleSection id="research" {...sectionContent.research} tone="paper">
    <Research items={researchAreas} headingLevel={3} />
  </ModuleSection>
  <ModuleSection id="news" {...sectionContent.news}>
    <News items={newsItems} headingLevel={3} />
  </ModuleSection>
  <ModuleSection id="publications" {...sectionContent.publications} tone="paper">
    <PublicationArchive items={publications} />
  </ModuleSection>
  <ModuleSection id="people" {...sectionContent.people}>
    <People items={people} headingLevel={3} />
  </ModuleSection>
  <ModuleSection id="contact" {...sectionContent.contact} tone="paper">
    <Contact content={contact} />
  </ModuleSection>
</BaseLayout>
