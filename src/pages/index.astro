---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleSection from '../components/ModuleSection.astro';
import Hero from '../components/modules/Hero.astro';
import Research from '../components/modules/Research.astro';
import People from '../components/modules/People.astro';
import Publications from '../components/modules/Publications.astro';
import News from '../components/modules/News.astro';
import Contact from '../components/modules/Contact.astro';
import { site, researchAreas, people, publications, newsItems, contact } from '../lib/content';
---

<BaseLayout title="Home">
  <Hero content={site} />
  <ModuleSection title="Research" href="/research/" linkLabel="View research">
    <Research items={researchAreas.slice(0, 3)} headingLevel={3} />
  </ModuleSection>
  <ModuleSection title="People" href="/people/" linkLabel="View people">
    <People items={people.slice(0, 3)} headingLevel={3} />
  </ModuleSection>
  <section class="section">
    <div class="page-shell updates-grid">
      <section>
        <div class="section-head"><h2 class="section-title">Publications</h2><a class="section-link" href="/publications/">View all</a></div>
        <Publications items={publications.slice(0, 2)} headingLevel={3} />
      </section>
      <section>
        <div class="section-head"><h2 class="section-title">News</h2><a class="section-link" href="/news/">View all</a></div>
        <News items={newsItems.slice(0, 2)} headingLevel={3} />
      </section>
    </div>
  </section>
  <ModuleSection title="Contact" href="/contact/" linkLabel="View contact">
    <Contact content={contact} />
  </ModuleSection>
</BaseLayout>
