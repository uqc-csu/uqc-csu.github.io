---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import People from '../components/modules/People.astro';
import { people, pageContent } from '../lib/content';
---

<BaseLayout title={pageContent.people.title}>
  <section class="page-intro"><SectionIntro {...pageContent.people} /></section>
  <section class="page-content"><div class="page-shell reading-width"><People items={people} /></div></section>
</BaseLayout>
