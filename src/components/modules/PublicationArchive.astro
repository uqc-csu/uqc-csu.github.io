---
import type { Publication } from '../../lib/content';
import Publications from './Publications.astro';
interface Props { items: Publication[] }
const { items } = Astro.props;
const years = [...new Set(items.map((item) => item.year))].sort((a, b) => b - a);
---

{items.length > 0 ? (
  <div class="publication-archive">
    <div class="archive-toolbar">
      <p>{items.length} journal articles</p>
      <a class="text-link" href="/publications.bib" download="uqc-publications.bib">Download all BibTeX <span aria-hidden="true">↓</span></a>
    </div>
    <nav class="year-links" aria-label="Publication years">
      {years.map((year) => (
        <a href={`#year-${year}`}><span>{year}</span><span class="year-count">{items.filter((item) => item.year === year).length}</span></a>
      ))}
    </nav>
    <div class="archive-entries">
      {years.map((year) => (
        <section class="publication-year-group" id={`year-${year}`} aria-labelledby={`year-${year}-heading`}>
          <h3 class="year-heading" id={`year-${year}-heading`}>{year}</h3>
          <Publications items={items.filter((item) => item.year === year)} headingLevel={4} />
        </section>
      ))}
    </div>
  </div>
) : <Publications items={[]} headingLevel={3} />}
