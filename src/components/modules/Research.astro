---
import type { ResearchArea } from '../../lib/content';
interface Props { items: ResearchArea[]; headingLevel?: 2 | 3 }
const { items, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

{items.length > 0 ? (
  <div class="research-list">
    {items.map((item, index) => (
      <article class="research-row">
        <span class="research-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <Heading class="research-title">{item.title}</Heading>
          <p class="research-summary">{item.summary}</p>
          {item.tags && item.tags.length > 0 && <ul class="topic-tags" aria-label="Topics">{item.tags.map((tag) => <li>{tag}</li>)}</ul>}
        </div>
      </article>
    ))}
  </div>
) : <p class="empty-state">Research information will be added here.</p>}
