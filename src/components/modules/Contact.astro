---
import type { ContactContent } from '../../lib/content';
interface Props { content: ContactContent }
const { content } = Astro.props;
const hasContent = Object.values(content).some((value) => value.trim());
---

{hasContent ? (
  <dl class="contact-details">
    {content.institution && <div><dt>Institution</dt><dd>{content.institution}</dd></div>}
    {content.department && <div><dt>Department</dt><dd>{content.department}</dd></div>}
    {content.address && <div><dt>Location</dt><dd>{content.address}</dd></div>}
    {content.email && <div><dt>Email</dt><dd><a href={`mailto:${content.email}`}>{content.email}</a></dd></div>}
    {content.website && <div><dt>Group website</dt><dd><a href={content.website}>X-MOL profile <span aria-hidden="true">↗</span></a></dd></div>}
  </dl>
) : <p class="empty-state">Contact information will be added here.</p>}
