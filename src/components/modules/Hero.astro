---
import type { SiteContent, ContactContent, ResearchArea } from '../../lib/content';
interface Props { content: SiteContent; affiliation: ContactContent; topics: ResearchArea[] }
const { content, affiliation, topics } = Astro.props;
---

<section class="hero" id="about" aria-labelledby="group-title">
  <div class="page-shell hero-grid">
    <aside class="group-identity" aria-label="Group affiliation">
      {content.image ? (
        <img class="group-image" src={content.image} alt={content.imageAlt} width="144" height="144" />
      ) : <div class="group-monogram" aria-hidden="true">{content.name || 'Group'}</div>}
      <p class="identity-name">{content.tagline || content.name}</p>
      <p class="identity-affiliation">{affiliation.department}<br />{affiliation.institution}</p>
      {affiliation.address && <p class="identity-location">{affiliation.address}</p>}
      {affiliation.website && <a class="text-link" href={affiliation.website}>X-MOL profile <span aria-hidden="true">↗</span></a>}
    </aside>
    <div class="hero-overview">
      <p class="eyebrow">Research group</p>
      <h1 id="group-title">{content.tagline || content.name || 'Research group'}</h1>
      {content.introduction && <p class="hero-copy">{content.introduction}</p>}
      {topics.length > 0 && (
        <div class="research-interests">
          <p class="small-label">Research interests</p>
          <ul>{topics.map((topic) => <li>{topic.title}</li>)}</ul>
        </div>
      )}
      <div class="hero-actions">
        <a class="button button-primary" href="#publications">Explore publications <span aria-hidden="true">→</span></a>
        <a class="text-link" href="#research">Our research <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
</section>
