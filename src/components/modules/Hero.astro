---
import type { SiteContent } from '../../lib/content';
import Placeholder from '../ui/Placeholder.astro';
interface Props { content: SiteContent }
const { content } = Astro.props;
---

<section class="hero">
  <div class="page-shell hero-grid">
    <div>
      <div class="eyebrow">Research group</div>
      <h1>{content.name ? content.name : <Fragment>Group<br />name.</Fragment>}</h1>
      {content.tagline ? <p class="hero-tagline">{content.tagline}</p> : <Placeholder label="Research statement placeholder" lines={1} compact />}
      {content.introduction ? <p class="hero-copy">{content.introduction}</p> : <Placeholder label="Introduction placeholder" />}
      <div class="hero-actions">
        <a class="button button-primary" href="/research/">Research <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="/contact/">Contact</a>
      </div>
    </div>
    <div class="hero-aside hero-image-slot">
      {content.image ? <img class="hero-image" src={content.image} alt={content.imageAlt} /> : (
        <div class="visual-placeholder" role="img" aria-label="Group image placeholder">
          <svg width="46" height="46" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <rect x="5" y="7" width="38" height="34" rx="5" stroke="currentColor" stroke-width="1.5" />
            <circle cx="16" cy="18" r="3" stroke="currentColor" stroke-width="1.5" />
            <path d="m7 35 11-10 8 7 7-6 8 9" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>Image</span>
        </div>
      )}
    </div>
  </div>
</section>
