---
import type { Person } from '../../lib/content';
interface Props { items: Person[]; headingLevel?: 2 | 3 }
const { items, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

{items.length > 0 ? (
  <div class="people-grid">
    {items.map((person) => (
      <article class="person-card">
        {person.image && <img class="person-image" src={person.image} alt={person.name} width="96" height="96" loading="lazy" />}
        <Heading>{person.homepage ? <a href={person.homepage}>{person.name}</a> : person.name}</Heading>
        {person.role && <p class="person-role">{person.role}</p>}
        {person.bio && <p>{person.bio}</p>}
      </article>
    ))}
  </div>
) : <p class="empty-state">Member information will be added here.</p>}
