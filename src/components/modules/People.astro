---
import type { Person } from '../../lib/content';
import Placeholder from '../ui/Placeholder.astro';
interface Props { items: Person[]; headingLevel?: 2 | 3 }
const { items, headingLevel = 2 } = Astro.props;
const entries: (Person | null)[] = items.length ? items : [null, null, null];
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<div class="people-grid">
  {entries.map((person) => (
    <article class="person-card card-border">
      {person?.image ? <img class="avatar avatar-image" src={person.image} alt={person.name} loading="lazy" /> : (
        <div class="avatar avatar-placeholder" role="img" aria-label="Portrait placeholder">
          <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <circle cx="16" cy="11" r="5" stroke="currentColor" stroke-width="1.3" />
            <path d="M6 28v-2a10 10 0 0 1 20 0v2" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </div>
      )}
      <Heading>{person?.homepage ? <a href={person.homepage}>{person.name}</a> : person?.name || 'Member name'}</Heading>
      {person?.role ? <p class="person-role">{person.role}</p> : <Placeholder label="Role placeholder" lines={1} compact />}
      {person?.bio ? <p>{person.bio}</p> : <Placeholder label="Biography placeholder" />}
    </article>
  ))}
</div>
