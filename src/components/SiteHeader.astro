---
import { navItems } from '../lib/navigation';
import { site, contact } from '../lib/content';
---

<header class="site-header">
  <div class="page-shell header-inner">
    <a class="brand" href="/#about" aria-label={`${site.name || 'Research group'} home`}>
      <span class="brand-name">{site.name || 'Research group'}</span>
      {contact.institution && <span class="brand-affiliation">{contact.institution}</span>}
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>
