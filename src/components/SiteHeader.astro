---
import { navItems } from '../lib/navigation';
import { site, isEmptyTemplate } from '../lib/content';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="page-shell header-inner">
    <a class="brand" href="/" aria-label="Home">
      <span class="brand-mark" aria-hidden="true"><span class="brand-symbol"></span></span>
      <span>{site.name || 'Group name'}<small>{isEmptyTemplate ? 'Template preview' : site.tagline}</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <details class="mobile-menu">
      <summary aria-label="Open navigation"><span></span></summary>
      <nav class="mobile-nav" aria-label="Mobile navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
