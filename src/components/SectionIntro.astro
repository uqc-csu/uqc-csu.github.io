---
import Placeholder from './ui/Placeholder.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="page-shell">
  <div class="eyebrow">Research group</div>
  <h1 class="section-title">{title}</h1>
  <div class="intro-placeholder"><Placeholder label={`${title} introduction placeholder`} lines={2} /></div>
</div>
