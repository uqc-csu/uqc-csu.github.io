---
interface Props { label?: string; lines?: number; compact?: boolean }
const { label = 'Content placeholder', lines = 3, compact = false } = Astro.props;
const widths = ['100%', '92%', '73%', '85%'];
---

<div class:list={['placeholder', { 'placeholder-compact': compact }]} role="img" aria-label={label}>
  {Array.from({ length: lines }, (_, index) => (
    <span class="placeholder-line" style={{ width: widths[index % widths.length] }} aria-hidden="true"></span>
  ))}
</div>
