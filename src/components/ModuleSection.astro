---
interface Props { id: string; title: string; description?: string; tone?: 'paper' | 'white' }
const { id, title, description, tone = 'white' } = Astro.props;
---

<section id={id} class:list={['section', `section-${tone}`]} aria-labelledby={`${id}-heading`}>
  <div class="page-shell section-layout">
    <div class="section-heading">
      <h2 id={`${id}-heading`}>{title}</h2>
      {description && <p class="section-description">{description}</p>}
    </div>
    <div class="section-content"><slot /></div>
  </div>
</section>
